{
  "version": 2,
  "public": true,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "ALLOWALL" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/agro-viewer", "destination": "/agro-viewer/index.html" },
    { "source": "/geluid-groen-viewer", "destination": "/geluid-groen-viewer/index.html" },
    { "source": "/som-viewer", "destination": "/som-viewer/index.html" },
    { "source": "/api/agro-proxy", "destination": "/api/agro-proxy.js" },
    { "source": "/api/proxy", "destination": "/api/proxy.js" },
    { "source": "/api/search-ngr", "destination": "/api/search-ngr.js" },
    { "source": "/", "destination": "/population-3d/index.html" }
  ]
}