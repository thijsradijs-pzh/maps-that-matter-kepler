{
  "version": 2,
  "public": true,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "ALLOWALL" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/agro-viewer", "destination": "/agro-viewer/index.html" },
    { "source": "/schiedam-bos", "destination": "/schiedam-bos/index.html" },
    { "source": "/geluid-groen-viewer", "destination": "/geluid-groen-viewer/index.html" },
    { "source": "/som-viewer", "destination": "/som-viewer/index.html" },
    { "source": "/gebiedsviewer", "destination": "/gebiedsviewer/index.html" },
    { "source": "/api/agro-proxy", "destination": "/api/agro-proxy.js" },
    { "source": "/api/proxy", "destination": "/api/proxy.js" },
    { "source": "/api/search-ngr", "destination": "/api/search-ngr.js" },
    { "source": "/api/ask-map", "destination": "/api/ask-map.js" },
    { "source": "/api/search-wms", "destination": "/api/search-wms.js" },
    { "source": "/api/ask-wfs", "destination": "/api/ask-wfs.js" },
    { "source": "/api/wfs-proxy", "destination": "/api/wfs-proxy.js" },
    { "source": "/api/suggest-location", "destination": "/api/suggest-location.js" },
    { "source": "/pdok-viewer", "destination": "/pdok-viewer/index.html" },
    { "source": "/vraag-de-kaart", "destination": "/vraag-de-kaart/index.html" },
    { "source": "/", "destination": "/population-3d/index.html" }
  ]
}