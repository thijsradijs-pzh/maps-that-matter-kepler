{
  "version": 2,
  "public": true,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "ALLOWALL"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/population-3d/index.html"
    },
    { "source": "/agro-viewer", "destination": "/agro-viewer/index.html" },
    { "source": "/api/agro-proxy", "destination": "/api/agro-proxy.js" }
  ]
}
